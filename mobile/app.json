{
  "expo": {
    "name": "KG OPS",
    "slug": "kg-steel-paint-checker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kg-paint-checker",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kgsteel.paintchecker"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.kgsteel.paintchecker",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "owner": "sergekang",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4B2D8E"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "생산계획서 촬영을 위해 카메라 접근이 필요합니다."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "생산계획서 사진을 선택하기 위해 갤러리 접근이 필요합니다."
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d5eafbc7-6a18-4e72-b118-34b7d801d7f9"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d5eafbc7-6a18-4e72-b118-34b7d801d7f9"
    }
  }
}
