# ──────────────────────────────────────────────────────────────
# 로컬 테스트용 secrets 템플릿
# 이 파일을 복사해서 secrets.toml 로 저장 후 실제 값 채우기:
#   cp .streamlit/secrets.toml.template .streamlit/secrets.toml
#
# secrets.toml 은 .gitignore 에 등록되어 있어 GitHub에 올라가지 않음
# ──────────────────────────────────────────────────────────────

SPREADSHEET_ID = "여기에_스프레드시트_ID"
SCHEDULE_NOTE_SPREADSHEET_ID = "여기에_메모_스프레드시트_ID"  # 없으면 삭제

[gcp_service_account]
type = "service_account"
project_id = "여기에_프로젝트_ID"
private_key_id = "여기에_키_ID"
private_key = "-----BEGIN RSA PRIVATE KEY-----\n여기에_키\n-----END RSA PRIVATE KEY-----\n"
client_email = "여기에@여기에.iam.gserviceaccount.com"
client_id = "여기에_클라이언트_ID"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "여기에_인증서_URL"

[members]
A = "여기에_A조_이름"
B = "여기에_B조_이름"
C = "여기에_C조_이름"
D = "여기에_D조_이름"
